# Archivo de ejemplo de variables de entorno
# Copia este archivo a .env y personaliza los valores
# NO commitear archivos .env con datos reales

# Ambiente de ejecución (local, test, prod)
APP_ENV=local

# Configuración del servidor
SERVER_HOST=localhost
SERVER_PORT=3000

# Base de datos relacional
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=myapp_dev

# Swagger/OpenAPI
SWAGGER_HOSTNAME=localhost

# MongoDB
MONGO_URL=mongodb://user:123@localhost:27017
MONGO_DB=dev_db
